# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local scripts with hardcoded credentials
/scripts/*
!/scripts/assemble-ad.mjs
!/scripts/ad2-config.json
!/scripts/ad3-config.json
!/scripts/build-n8n-workflows.mjs
!/scripts/scrape-benchmark-reels.mjs
!/scripts/analyze-benchmark-reels.mjs
!/scripts/benchmark-accounts.json
!/scripts/deploy-shorts-site.mjs
!/scripts/fetch-stock-clips.mjs
# 긁은 릴스 원본은 커밋 안 함 (용량·재생성 가능)
/scripts/output/

# ad video working files (clips, mp3, output)
/ad-work/

# 주의: assets/video/ (릴스 b-roll 스톡)은 gitignore 하면 안 된다 —
# Remotion deploySite 가 publicDir 에서 .gitignore 를 존중해 클립을 S3 에 안 올린다.
# 재생성은 scripts/fetch-stock-clips.mjs.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.vercel

# python
__pycache__/

# n8n import files with injected secret
/n8n/dist/
