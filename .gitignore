# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local scripts with hardcoded credentials
/scripts/*
!/scripts/assemble-ad.mjs
!/scripts/ad2-config.json
!/scripts/ad3-config.json
!/scripts/build-n8n-workflows.mjs
!/scripts/scrape-benchmark-reels.mjs
!/scripts/analyze-benchmark-reels.mjs
!/scripts/benchmark-accounts.json
!/scripts/deploy-shorts-site.mjs
!/scripts/fetch-stock-clips.mjs
# 긁은 릴스 원본은 커밋 안 함 (용량·재생성 가능)
/scripts/output/

# ad video working files (clips, mp3, output)
/ad-work/

# 릴스 b-roll 스톡 영상 — 재생성 가능(scripts/fetch-stock-clips.mjs), 배포는 로컬 assets→S3.
# git 에 넣지 않아 저장소를 가볍게 유지. 새 클론은 배포 전 fetch 스크립트 1회 실행.
/assets/video/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.vercel

# python
__pycache__/

# n8n import files with injected secret
/n8n/dist/
