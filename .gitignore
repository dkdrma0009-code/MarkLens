# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local scripts with hardcoded credentials
/scripts/*
!/scripts/assemble-ad.mjs
!/scripts/ad2-config.json

# ad video working files (clips, mp3, output)
/ad-work/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.vercel
